{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qbank-connector",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Stores OAuth clients and tokens. Create with: npx wrangler kv namespace create OAUTH_KV
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "4b2e4c7797ac4ded9a669db735878b49" }],
  "vars": {
    "REPO": "ryanmcgann4/qbank-data",
    "BRANCH": "main",
    "TIMEZONE": "America/Chicago"
  }
  // Secrets (set in the Cloudflare dashboard or with `npx wrangler secret put NAME`):
  //   GITHUB_TOKEN  fine-grained token, Contents read & write on the sync repo only
  //   PASSPHRASE    what you type when connecting Claude
}
