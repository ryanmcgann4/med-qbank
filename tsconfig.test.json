{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": [
      "vite/client",
      "vite-plugin-pwa/react",
      "node"
    ]
  },
  "include": [
    "src/**/*.test.ts",
    "src/test",
    "scripts"
  ],
  // Runs with tsx and imports the connector, which is typed for Cloudflare Workers (see connector/tsconfig.json).
  "exclude": ["scripts/qbank-local.ts"]
}
